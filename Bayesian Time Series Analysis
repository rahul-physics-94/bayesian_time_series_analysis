rint(\"\\nMissing values:\")\n    print(\"X_train:\", X_train.isna().sum().sum())\n    print(\"X_test:\", X_test.isna().sum().sum())\n    print(\"y_train:\", y_train.isna().sum())\n\n    # Fail explicitly rather than letting PyMC produce a cryptic error\n    if X_train.isna().any().any():\n        raise ValueError(\"X_train contains NaN/non-numeric values\")\n\n    if X_test.isna().any().any():\n        raise ValueError(\"X_test contains NaN/non-numeric values\")\n\n    if y_train.isna().any():\n        raise ValueError(\"y_train contains NaN/non-numeric values\")\n\n    # Convert to NumPy float arrays\n    X_train = X_train.to_numpy(dtype=np.float64)\n    X_test = X_test.to_numpy(dtype=np.float64)\n    y_train = y_train.to_numpy(dtype=np.float64)\n\n    with pm.Model() as ts_model:\n\n        x_data = pm.Data(\n            \"x_data\",\n            X_train\n        )\n\n        alpha = pm.Normal(\n            \"alpha\",\n            mu=0,\n            sigma=10\n        )\n\n        betas = pm.Normal(\n            \"betas\",\n            mu=0,\n            sigma=5,\n            shape=X_train.shape[1]\n        )\n\n        sigma = pm.HalfNormal(\n            \"sigma\",\n            sigma=5\n        )\n\n        mu = alpha + pm.math.dot(x_data, betas)\n\n        y_obs = pm.Normal(\n            \"y_obs\",\n            mu=mu,\n            sigma=sigma,\n            observed=y_train\n        )\n\n        trace = pm.sample(\n            draws=100,\n            tune=100,\n            chains=2,\n            progressbar = True,\n            target_accept=0.9\n        )\n\n        pm.set_data({\n            \"x_data\": X_test\n        })\n\n        posterior_preds = pm.sample_posterior_predictive(\n            trace,\n            var_names=[\"y_obs\"],\n            predictions=True\n        )\n\n    return trace, posterior_preds","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-07T21:21:52.297669Z","iopub.execute_input":"2026-08-07T21:21:52.298765Z","iopub.s